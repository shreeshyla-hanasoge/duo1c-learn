/**
 * Wires the films into Remotion and into the site.
 *
 *   node --experimental-strip-types scripts/sync.mts
 *
 * 1. Writes `src/specs/index.ts` — the list `Root.tsx` registers — from the
 *    spec files present, so adding a film is adding one file.
 * 2. Writes `../src/data/systems/films.ts` — topic id → the `conceptFilm` the
 *    lesson shows — for every spec whose rendered video exists in
 *    `../public/media/concept-films/`. A spec without a video is left out, so
 *    the site never points at a missing file.
 */
import { existsSync, readdirSync, writeFileSync } from "node:fs";
import { fileURLToPath, pathToFileURL } from "node:url";
import { dirname, join } from "node:path";
import type { FlowSpec } from "../src/kit/types.ts";

const here = dirname(fileURLToPath(import.meta.url));
const dir = join(here, "..", "src", "specs");
const media = join(here, "..", "..", "public", "media", "concept-films");
const ids = readdirSync(dir)
  .filter((f) => f.startsWith("sd-") && f.endsWith(".ts"))
  .map((f) => f.replace(/\.ts$/, ""))
  .sort();

const rows: { id: string; name: string; spec: FlowSpec }[] = [];
for (const id of ids) {
  const mod = await import(pathToFileURL(join(dir, `${id}.ts`)).href);
  const [name, spec] = Object.entries(mod)[0] as [string, FlowSpec];
  rows.push({ id, name, spec });
}

writeFileSync(
  join(dir, "index.ts"),
  `// Generated by scripts/sync.mts — do not edit by hand.\n` +
    `import type { FlowSpec } from "../kit/types";\n` +
    rows.map((r) => `import { ${r.name} } from "./${r.id}";`).join("\n") +
    `\n\nexport const SPECS: FlowSpec[] = [\n` +
    rows.map((r) => `  ${r.name},`).join("\n") +
    `\n];\n`,
);

const rendered = rows.filter((r) => existsSync(join(media, `${r.id}.mp4`)));
writeFileSync(
  join(here, "..", "..", "src", "data", "systems", "films.ts"),
  `// Generated by films/scripts/sync.mts — do not edit by hand.\n` +
    `// One entry per rendered data-flow film; the source is films/src/specs/<id>.ts.\n` +
    `import type { ConceptFilm } from "../types.ts";\n\n` +
    `export const FILMS: Record<string, ConceptFilm> = {\n` +
    rendered
      .map(
        (r) =>
          `  ${JSON.stringify(r.id)}: {\n` +
          `    src: ${JSON.stringify(`/media/concept-films/${r.id}.mp4`)},\n` +
          `    title: ${JSON.stringify(r.spec.lesson.title)},\n` +
          `    kind: "flow",\n` +
          `    watchFor: ${JSON.stringify(r.spec.lesson.watchFor)},\n` +
          `  },\n`,
      )
      .join("") +
    `};\n`,
);

console.log(`${rows.length} specs registered, ${rendered.length} rendered films wired into the site`);
